{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": true,
    "dotted_date": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "before NUM UNIT MARKER",
        "MARKER indef? NUM UNIT",
        "MARKER QUANT UNIT",
        "QUANT UNIT MARKER",
        "before QUANT UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "article? DAY MONTH YEAR?",
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR in? MERIDIEM? ZONE?",
        "FRACTION CLOCKDIR HOUR in? MERIDIEM? ZONE?",
        "FRACTION HOUR in? MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR in? MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR LANDMARK ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?",
        "FRACTION LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "before NUM SCALE year_word ago",
        "NUM SCALE year_word ago",
        "ago NUM SCALE year_word"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART of MONTH",
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true
  },
  "quantifiers": {
    "1": [
      "en",
      "et"
    ],
    "0.5": [
      "halv"
    ],
    "0.25": [
      "kvart"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_germanic:fold_da"
}
