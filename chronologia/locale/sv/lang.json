{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "before NUM UNIT MARKER",
        "MARKER indef? NUM UNIT",
        "MARKER QUANT UNIT",
        "QUANT UNIT MARKER",
        "before QUANT UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "article? DAY MONTH YEAR?",
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "at? CLOCK of? MERIDIEM ZONE?",
        "at? CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "at? HOUR of? MERIDIEM ZONE?",
        "at? FRACTION CLOCKDIR HOUR of? MERIDIEM ZONE?",
        "at? FRACTION HOUR of? MERIDIEM ZONE?",
        "MINUTE CLOCKDIR HOUR of? MERIDIEM ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "FRACTION HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR LANDMARK ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?",
        "FRACTION LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "before NUM SCALE year_word ago",
        "NUM SCALE year_word ago",
        "ago NUM SCALE year_word"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "NUM plural"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART of MONTH",
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true
  },
  "quantifiers": {
    "1": [
      "en",
      "ett"
    ],
    "0.5": [
      "halv"
    ],
    "0.25": [
      "kvart"
    ],
    "1.5": [
      "halvannan"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "number_fold": {
    "compounds": [
      {
        "heads": {
          "halv": "halv"
        },
        "tails": [
          "timme",
          "timmen"
        ],
        "source": "Swedish counts a fraction of an hour as a length with the article and the bare fraction word, or with the compound noun: \"om en halv timme\" / \"om en halvtimme\" (in half an hour), \"om en kvart\" (in a quarter of an hour). Wiktionary: halvtimme \"half an hour, a half-hour\"; kvart \"a quarter of an hour, 15 minutes\"."
      }
    ],
    "fraction_counts": [
      {
        "word": "halv",
        "value": 0.5,
        "source": "\"halv\" and \"kvart\" are kept out of the cardinal fold because the clock reads them as FRACTION (\"halv tre\" = 02:30, \"kvart över tre\" = 03:15), so the length reading is rewritten here instead, and only where a unit noun follows or the phrase is the bare \"en kvart\" with no clock direction after it: the count 1 and the fraction word become one 0.5 / 0.25 count, and the compound splits into its two words first."
      },
      {
        "word": "kvart",
        "value": 0.25,
        "unit": "timme",
        "not_before": [
          "över",
          "i"
        ]
      }
    ],
    "h_clock_markers": [
      "klockan",
      "kl"
    ]
  },
  "base_grammar": {
    "disable": [
      "calendar_date"
    ]
  }
}
