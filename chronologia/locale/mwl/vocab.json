 "sources": {
  "marker_year_plural": [
   "The plural year noun that frames a decade (\"ls anhos 80\"); the singular",
   "\"anho\" names a single year and must not reach the decade slot.",
   "Sources: Wiktionary, s.v. \"anho\" (https://en.wiktionary.org/wiki/anho),",
   "Mirandese noun: \"anho m (plural anhos)\"; and the decade surface in",
   "running text on the Biquipedia -- \"nun eirie para alhá de ls anhos 80 de",
   "l seclo XX\" (mwl.wikipedia.org/wiki/Lhéngua_mirandesa)."
  ],
  "scope_unit_century": [
   "\"seclo\" is the Mirandese word for \"century\", attested in native running",
   "text on the Mirandese Wikipedia (Biquipédia), e.g. the article title",
   "\"Seclo XX\" (mwl.wikipedia.org/wiki/Seclo_XX). Plural \"seclos\" follows the",
   "regular -o -> -os pattern already used across this locale's other",
   "unit_*.voc files."
  ],
  "scope_unit_decade": [
   "\"decada\" (also written with the Portuguese-style accent \"década\") is",
   "attested in native running text on the Mirandese Wikipedia (Biquipédia),",
   "e.g. category titles \"Catadorie:Década de 1850\" and \"Catadorie:Década de",
   "2000\" (mwl.wikipedia.org). Both spellings are listed since Mirandese",
   "orthography does not consistently mark this accent (mirrors the pt",
   "unit_decade.voc accented/unaccented pair)."
  ],
  "unit_century": [
   "\"seclo\" is the Mirandese word for \"century\", attested in native running",
   "text on the Mirandese Wikipedia (Biquipédia), e.g. the article title",
   "\"Seclo XX\" (mwl.wikipedia.org/wiki/Seclo_XX). Plural \"seclos\" follows the",
   "regular -o -> -os pattern already used across this locale's other",
   "unit_*.voc files."
  ],
  "unit_decade": [
