{
  "tokenizer": {
    "split_contractions": true,
    "ordinal_dot": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER of? NUM UNIT",
        "NUM UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "article? WEEKDAY REL_MARKER",
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "REL_MARKER UNIT",
        "article? UNIT REL_MARKER"
      ]
    },
    "calendar_date": {
      "orders": [
        "article? DAY of MONTH of? YEAR?",
        "article? DAY MONTH YEAR?",
        "MONTH of? YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "article? SEASON of YEAR",
        "REL_MARKER SEASON",
        "article? SEASON YEAR?"
      ]
    },
    "clock_time": {
      "orders": [
        "at? HOUR CLOCKDIR FRACTION of? article? MERIDIEM? ZONE?",
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR of? article? MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word of? GYEAR",
        "GYEAR"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "article? PART of? MONTH"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? article? year_word NUM"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "un",
      "ua",
      "uma"
    ],
    "0.5": [
      "meia",
      "meio"
    ],
    "0.25": [
      "quarto",
      "quartos"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_mwl"
}
