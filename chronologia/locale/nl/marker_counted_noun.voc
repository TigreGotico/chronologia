# Nouns that count people or things a clock never takes: a bare hour behind a
# clock preposition and directly before one of them is a count ("wave at 5
# people").  Each word is quoted from its Wiktionary Noun entry
# (https://en.wiktionary.org/wiki/<word>); the fetched pages are kept with the audit.
# persoon: Noun. "person, individual"
# personen: Noun. "plural of persoon"
# mensen: Noun. "plural of mens"
# gasten: Noun. "plural of gast"
# buren: Noun. "plural of buur"
# vrienden: Noun. "plural of vriend"
# kinderen: Noun. "plural of kind"
# volwassenen: Noun. "plural of volwassene"
# spelers: Noun. "plural of speler"
# stoelen: Noun. "plural of stoel"
# tafels: Noun. "plural of tafel"
# kaartjes: Noun. "plural of kaartje"
# kamers: Noun. "plural of kamer"
# euro: Noun. "euro currency"
# man: Noun. "man, human male, either adult or age-irrespective"
# mannen: Noun. "plural of man"
# redenen: Noun. "plural of reden"
persoon
personen
mensen
gasten
buren
vrienden
kinderen
volwassenen
spelers
stoelen
tafels
kaartjes
kamers
euro
man
mannen
redenen
