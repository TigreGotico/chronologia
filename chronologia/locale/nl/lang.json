{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? year_word NUM bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "MARKER indef? NUM UNIT",
        "indef? NUM UNIT MARKER",
        "MARKER QUANT UNIT",
        "QUANT UNIT MARKER",
        "before QUANT UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "REL_MARKER UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "REL_MARKER SEASON",
        "SEASON of YEAR",
        "SEASON YEAR?"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? ORD SEL_UNIT of article? SORD SCOPE_UNIT",
        "article? ORD UNIT of MONTH YEAR?",
        "article? ORD UNIT of article? year_word YEAR?",
        "article? ORD SCOPE_UNIT"
      ]
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "HOUR oclock MERIDIEM? ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "FRACTION HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR LANDMARK ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?",
        "FRACTION LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE year_word ago",
        "ago NUM SCALE year_word"
      ]
    },
    "named_period": {
      "orders": [
        "in? during? article? PART? PERIOD"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "numeric_date": {
      "orders": [
        "NUMDATE"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "half_period": {
      "orders": [
        "article? NUM half of GYEAR",
        "article? NUM half of article? SCOPE_UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true
  },
  "quantifiers": {
    "1": [
      "een"
    ],
    "0.5": [
      "half"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_nl"
}
