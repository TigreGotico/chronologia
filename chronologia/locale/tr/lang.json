{
  "positions": {
    "until": "post"
  },
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": false,
    "dotted_date": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "MERIDIEM CLOCK ZONE?",
        "at HOUR MINUTE CLOCKDIR MERIDIEM? ZONE?",
        "at HOUR FRACTION CLOCKDIR MERIDIEM? ZONE?",
        "MERIDIEM at HOUR MINUTE CLOCKDIR ZONE?",
        "MERIDIEM at HOUR FRACTION CLOCKDIR ZONE?",
        "MERIDIEM HOUR MINUTE CLOCKDIR ZONE?",
        "MERIDIEM HOUR FRACTION CLOCKDIR ZONE?",
        "at HOUR FRACTION MERIDIEM? ZONE?",
        "MERIDIEM at HOUR FRACTION ZONE?",
        "MERIDIEM HOUR FRACTION ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "MERIDIEM at HOUR ZONE?",
        "MERIDIEM HOUR ZONE?",
        "HOUR MINUTE CLOCKDIR MERIDIEM? ZONE?",
        "HOUR FRACTION CLOCKDIR MERIDIEM? ZONE?",
        "HOUR FRACTION MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc",
        "bc NUM"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "year_ref": {
      "orders": [
        "GYEAR"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "REL_MARKER UNIT PART",
        "UNIT PART",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true,
    "bare_half_past": true
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_turkic:fold_tr",
  "quantifiers": {
    "1": [
      "bir"
    ],
    "0.5": [
      "yarım"
    ],
    "0.25": [
      "çeyrek"
    ]
  },
  "base_grammar": {
    "season_year_order": "year_first",
    "marker_position": {
      "weekday_ref": "post",
      "rel_period": "post"
    },
    "extend": {
      "month_fuzzy": [
        "MONTH PART"
      ],
      "half_period": [
        "GYEAR poss? NUM half"
      ],
      "weekday_ref": [
        "WEEKDAYFULL weekday_word",
        "REL_MARKER WEEKDAY weekday_word"
      ]
    }
  }
}
