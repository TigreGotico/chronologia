{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER NUM UNIT",
        "NUM UNIT MARKER",
        "MARKER indef? NUM of? UNIT",
        "indef? NUM UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {"orders": ["REL_MARKER UNIT"]},
    "weekend_ref": {"orders": ["REL_MARKER WEEKEND", "article? WEEKEND"]},
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "REL_MARKER SEASON",
        "SEASON of YEAR",
        "SEASON YEAR?"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? ORD SEL_UNIT of article? SORD SCOPE_UNIT",
        "article? ORD UNIT of MONTH YEAR?",
        "article? ORD UNIT of article? year_word YEAR?",
        "article? ORD SCOPE_UNIT"
      ]
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM?",
        "at HOUR MERIDIEM?",
        "HOUR oclock MERIDIEM?",
        "FRACTION CLOCKDIR HOUR MERIDIEM?",
        "FRACTION HOUR MERIDIEM?",
        "MINUTE CLOCKDIR HOUR MERIDIEM?",
        "MINUTE CLOCKDIR LANDMARK",
        "at? LANDMARK",
        "FRACTION CLOCKDIR LANDMARK",
        "FRACTION LANDMARK"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "ago NUM SCALE year_word",
        "NUM SCALE year_word ago"
      ]
    },
    "named_period": {
      "orders": [
        "in? during? article? PART? PERIOD"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "article? PART? DECADE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "half_period": {
      "orders": [
        "article? NUM half of GYEAR",
        "article? NUM half of article? SCOPE_UNIT"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true
  },
  "quantifiers": {
    "1": [
      "ein",
      "eine",
      "einen"
    ],
    "2": [
      "paar"
    ],
    "3": [
      "einige",
      "mehrere"
    ],
    "0.5": [
      "halb"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_de"
}