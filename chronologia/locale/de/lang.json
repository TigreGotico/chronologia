{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": true,
    "ordinal_dot_max_digits": 2,
    "dotted_date": true
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? NUM plural bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "MARKER NUM UNIT",
        "NUM UNIT MARKER",
        "MARKER indef? NUM of? UNIT",
        "indef? NUM UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "at HOUR oclock MERIDIEM? ZONE?",
        "HOUR oclock MERIDIEM? ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "FRACTION HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR LANDMARK ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?",
        "FRACTION LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "ago NUM SCALE year_word",
        "NUM SCALE year_word ago"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "article? PART? DECADE year_plural?",
        "PART? article? NUM plural year_plural?"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?",
        "article? ORD week_num of YEAR",
        "article? ORD week_num YEAR?"
      ]
    },
    "roman_date": {
      "orders": [
        "article? ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY MONTH"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true,
    "bare_quarter_to": true
  },
  "quantifiers": {
    "1": [
      "ein",
      "eine",
      "einen"
    ],
    "2": [
      "paar"
    ],
    "3": [
      "einige",
      "mehrere"
    ],
    "0.5": [
      "halb"
    ],
    "0.25": [
      "viertel"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_germanic:fold_de",
  "base_grammar": {
    "extend": {
      "season_ref": [
        "during article? SEASON YEAR?"
      ]
    }
  }
}