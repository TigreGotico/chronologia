{
  "positions": {
    "until": "post"
  },
  "tokenizer": {
    "decimal_comma": true,
    "dotted_date": true,
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "MERIDIEM CLOCK ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "MERIDIEM at HOUR ZONE?",
        "MERIDIEM HOUR ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad"
      ]
    },
    "year_ref": {
      "orders": [
        "GYEAR"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "REL_MARKER UNIT PART",
        "UNIT PART",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true,
    "offset_clock_composes": true
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_turkic:fold_az",
  "quantifiers": {
    "1": [
      "bir"
    ],
    "0.5": [
      "yarım"
    ],
    "0.25": [
      "rüb"
    ]
  },
  "base_grammar": {
    "season_year_order": "year_first",
    "marker_position": {
      "weekday_ref": "post",
      "rel_period": "post"
    }
  }
}
