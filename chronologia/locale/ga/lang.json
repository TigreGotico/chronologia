{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": false,
  "dotted_date": false
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "NUM UNIT MARKER",
    "USG MARKER"
   ]
  },
  "weekend_ref": {
   "orders": [
    "article? WEEKEND REL_MARKER",
    "WEEKEND"
   ]
  },
  "calendar_date": {
   "orders": [
    "in? DAY MONTH YEAR?",
    "in? MONTH DAY? YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK MERIDIEM?",
    "at HOUR oclock MERIDIEM?",
    "HOUR oclock MERIDIEM?",
    "at HOUR MERIDIEM",
    "FRACTION CLOCKDIR at? HOUR oclock? MERIDIEM?",
    "FRACTION CLOCKDIR LANDMARK",
    "MINUTE minute_word? CLOCKDIR at? HOUR oclock? MERIDIEM?",
    "MINUTE minute_word? CLOCKDIR LANDMARK",
    "at? LANDMARK"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "GYEAR"
   ]
  }
 },
 "base_grammar": {
  "marker_position": {
   "weekday_ref": "post",
   "rel_period": "post"
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true
 },
 "positions": {
  "until": "pre",
  "for": "pre"
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_irish:fold_ga"
}
