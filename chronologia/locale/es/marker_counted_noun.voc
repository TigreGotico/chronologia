# Nouns that count people or things a clock never takes: a bare hour behind a
# clock preposition and directly before one of them is a count ("wave at 5
# people").  Each word is quoted from its Wiktionary Noun entry
# (https://en.wiktionary.org/wiki/<word>); the fetched pages are kept with the audit.
# persona: Noun. "person"
# personas: Noun. "plural of persona"
# invitados: Noun. "form of invitado"
# invitadas: Noun. "form of invitada"
# vecino: Noun. "neighbour"
# vecinos: Noun. "plural of vecino"
# vecinas: Noun. "form of vecina"
# amigo: Noun. "friend"
# amigos: Noun. "form of amigo"
# amigas: Noun. "plural of amiga"
# niños: Noun. "plural of niño"
# niñas: Noun. "plural of niña"
# chicos: Noun. "form of chico"
# chicas: Noun. "form of chica"
# adultos: Noun. "form of adulto"
# jugadores: Noun. "plural of jugador"
# jugadoras: Noun. "form of jugadora"
# asientos: Noun. "plural of asiento"
# sillas: Noun. "plural of silla"
# mesas: Noun. "plural of mesa"
# entradas: Noun. "form of entrada"
# habitaciones: Noun. "plural of habitación"
# alumnos: Noun. "plural of alumno"
# alumnas: Noun. "plural of alumna"
# primos: Noun. "plural of primo"
# primas: Noun. "form of prima"
# gatos: Noun. "plural of gato"
# gatas: Noun. "plural of gata"
# euros: Noun. "plural of euro"
persona
personas
invitados
invitadas
vecino
vecinos
vecinas
amigo
amigos
amigas
