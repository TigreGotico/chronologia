{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER from? NUM UNIT",
        "MARKER from? indef? UNIT",
        "NUM UNIT MARKER",
        "indef? UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER article? WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR article? MERIDIEM? ZONE?",
        "HOUR article? MERIDIEM ZONE?",
        "HOUR CLOCKDIR FRACTION article? MERIDIEM? ZONE?",
        "HOUR CLOCKDIR MINUTE article? MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "deep_time": {
      "orders": [
        "ago NUM SCALE year_word",
        "NUM SCALE year_word ago"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER article? quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "PART of? article? UNIT",
        "PART of? article? REL_MARKER UNIT",
        "REL_MARKER UNIT PART",
        "UNIT PART"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": false
  },
  "quantifiers": {
    "1": [
      "ένα",
      "μια",
      "μία",
      "έναν"
    ],
    "2": [
      "ζευγάρι"
    ],
    "3": [
      "μερικά",
      "μερικές"
    ],
    "0.5": [
      "μισή",
      "μισό"
    ],
    "0.25": [
      "τέταρτο"
    ],
    "1.5": [
      "μιάμιση"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_agglutinative:fold_el",
  "base_grammar": {
    "marker_position": {
      "weekday_ref": "post",
      "rel_period": "post"
    },
    "override": {
      "rel_period": [
        "article? REL_MARKER article? UNIT"
      ],
      "daypart_ref": [
        "REL_MARKER article? DAYPART",
        "article? DAYPART"
      ]
    },
    "extend": {
      "weekday_ref": [
        "article? REL_MARKER article? WEEKDAY"
      ]
    }
  }
}
