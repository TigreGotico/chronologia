{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER NUM UNIT",
        "MARKER indef? UNIT",
        "NUM UNIT MARKER",
        "indef? UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "article? REL_MARKER article? UNIT",
        "UNIT REL_MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER article? WEEKEND",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "DAY of MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "REL_MARKER SEASON",
        "SEASON of YEAR",
        "SEASON YEAR?"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? ORD SEL_UNIT of article? SORD SCOPE_UNIT",
        "article? ORD UNIT of MONTH YEAR?",
        "article? ORD SCOPE_UNIT"
      ]
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "HOUR CLOCKDIR FRACTION MERIDIEM? ZONE?",
        "HOUR CLOCKDIR MINUTE MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "deep_time": {
      "orders": [
        "ago NUM SCALE year_word",
        "NUM SCALE year_word ago"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "iso_week_date": {"orders": ["ISOWEEK"]},
    "numeric_date": {
      "orders": [
        "NUMDATE"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "half_period": {
      "orders": [
        "article? NUM half of GYEAR",
        "article? NUM half of article? SCOPE_UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER article? quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "PART of? article? UNIT",
        "PART of? article? REL_MARKER UNIT",
        "REL_MARKER UNIT PART",
        "UNIT PART"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": false
  },
  "quantifiers": {
    "1": [
      "ένα",
      "μια",
      "μία",
      "έναν"
    ],
    "2": [
      "ζευγάρι"
    ],
    "3": [
      "μερικά",
      "μερικές"
    ],
    "0.5": [
      "μισή",
      "μισό"
    ],
    "0.25": [
      "τέταρτο"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_agglutinative:fold_el"
}
