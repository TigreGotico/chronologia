 "sources": {
  "clock_meridiem_am": [
   "Morning words that follow a clock and fix its half of the day (offset 0):",
   "\"klokka sju om morgenen\" is 07:00.  The bare words \"morgen\" and \"morgon\" are",
   "the day after today, so only the definite forms are listed.",
   "Bokmålsordboka (https://ordbokene.no/bm), \"morgen\": \"klokka sju om morgenen\"; \"kveld\": \"klokka ni om kvelden\", \"i kveld er det fullmåne\"; \"ettermiddag\": \"tidsrom fra klokka 12 eller middag og til kveld\", \"om ettermiddagen\"; \"formiddag\": \"utpå formiddagen\"."
  ],
  "clock_meridiem_pm": [
   "Afternoon and evening words that follow a clock and fix its half of the day",
   "(offset +12): \"klokka ni om kvelden\" is 21:00 and \"klokka åtte i kveld\" is",
   "20:00.",
   "Bokmålsordboka (https://ordbokene.no/bm), \"morgen\": \"klokka sju om morgenen\"; \"kveld\": \"klokka ni om kvelden\", \"i kveld er det fullmåne\"; \"ettermiddag\": \"tidsrom fra klokka 12 eller middag og til kveld\", \"om ettermiddagen\"; \"formiddag\": \"utpå formiddagen\"."
  ],
  "daypart_ettermiddag_nb": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale no",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
   "transcribed in chronologia/dayparts.py as [12:00, 18:00).",
   "Sources: Bokmalsordboka, Sprakradet and the University of Bergen",
   "(https://ordbokene.no/bm/search?q=formiddag), which gives formiddag as",
   "the \"tid mellom frokost og klokka tolv eller middagstid\"."
  ],
  "daypart_formiddag_nb": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale no",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
