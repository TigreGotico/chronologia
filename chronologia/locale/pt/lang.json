{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": true
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? year_word NUM bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER of? NUM UNIT"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "REL_MARKER UNIT",
        "UNIT REL_MARKER"
      ]
    },
    "calendar_date": {
      "orders": [
        "article? DAY of MONTH of? YEAR?",
        "article? DAY MONTH YEAR?",
        "MONTH of? YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "DAY of CAL_MONTH YEAR?",
        "DAY CAL_MONTH YEAR?",
        "CAL_MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "article? SEASON of YEAR",
        "REL_MARKER SEASON",
        "article? SEASON YEAR?"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? ORD UNIT of MONTH YEAR?",
        "article? ordlast UNIT of MONTH YEAR?",
        "article? ORD UNIT of article? year_word YEAR?",
        "article? ordlast UNIT of article? year_word YEAR?",
        "article? ORD SCOPE_UNIT"
      ]
    },
    "clock_time": {
      "orders": [
        "at? HOUR CLOCKDIR FRACTION of? article? MERIDIEM? ZONE?",
        "at HOUR of? article? MERIDIEM? ZONE?",
        "at? HOUR of? article? MERIDIEM ZONE?",
        "at? HOUR MERIDIEM ZONE?",
        "at? LANDMARK of? article? MERIDIEM? ZONE?",
        "CLOCK MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "article? PART of? MONTH"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? article? year_word NUM"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word of? GYEAR",
        "GYEAR"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "um",
      "uma"
    ],
    "0.5": [
      "meia",
      "meio"
    ],
    "0.25": [
      "quarto",
      "quartos"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_pt"
}