{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": true
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? year_word NUM bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER offsetlink? NUM QUANT of? UNIT",
        "MARKER offsetlink? NUM of? UNIT",
        "MARKER offsetlink? QUANT of? UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND REL_MARKER",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "article? DAY of MONTH of? YEAR?",
        "article? DAY MONTH YEAR?",
        "MONTH of? YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "at? HOUR oclock? CLOCKDIR article? FRACTION of? article? MERIDIEM? ZONE?",
        "at? HOUR oclock? CLOCKDIR MINUTE of? article? MERIDIEM? ZONE?",
        "at HOUR oclock? of? article? MERIDIEM? ZONE?",
        "at? HOUR oclock? of? article? MERIDIEM ZONE?",
        "at? HOUR oclock? MERIDIEM ZONE?",
        "at? LANDMARK CLOCKDIR article? FRACTION of? article? MERIDIEM? ZONE?",
        "at? LANDMARK CLOCKDIR MINUTE of? article? MERIDIEM? ZONE?",
        "at? LANDMARK of? article? MERIDIEM? ZONE?",
        "at? CLOCK MERIDIEM? ZONE?",
        "FRACTION CLOCKDIR article? HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR article? HOUR MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "article? PART of? MONTH"
      ]
    },
    "decade_ref": {
      "orders": [
        "article? PART? of? article? year_word NUM"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word of? GYEAR",
        "GYEAR"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "solar_event": {
      "orders": [
        "article? EVENT of SEASON YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "roman_date": {
      "orders": [
        "article? ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY MONTH"
      ]
    },
    "rel_span": {
      "orders": [
        "NUM REL_MARKER UNIT",
        "article? NUM REL_MARKER UNIT"
      ]
    },
    "rel_span_quarter": {
      "orders": [
        "article? NUM REL_MARKER quarter_word"
      ]
    },
    "rel_span_weekend": {
      "orders": [
        "article? NUM REL_MARKER WEEKEND"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true,
    "bare_at_markers": ["a", "as"]
  },
  "quantifiers": {
    "1": [
      "um",
      "uma"
    ],
    "0.5": [
      "meia",
      "meio"
    ],
    "0.25": [
      "quarto",
      "quartos"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_romance:fold_pt",
  "base_grammar": {
    "marker_position": "post",
    "override": {
      "daypart_ref": [
        "REL_MARKER DAYPART",
        "article DAYPART",
        "of DAYPART",
        "at DAYPART",
        "dayframe DAYPART",
        "article? DAYPART REL_MARKER"
      ]
    },
    "extend": {
      "scoped_ordinal": [
        "article? CMUNIT ORD"
      ]
    }
  }
}