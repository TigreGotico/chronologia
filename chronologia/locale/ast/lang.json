{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "MARKER indef? QUANT? of? indef? UNIT",
        "MARKER indef? NUM of? indef? UNIT",
        "indef? QUANT? of? indef? UNIT MARKER",
        "indef? NUM of? indef? UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "named_day_after": {
      "orders": [
        "article? indef? UNIT after DAY_WORD"
      ]
    },
    "named_day_before": {
      "orders": [
        "article? indef? UNIT before DAY_WORD"
      ]
    },
    "weekday_offset": {
      "orders": [
        "indef? QUANT? UNIT from WEEKDAY",
        "indef? NUM UNIT from WEEKDAY"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND REL_MARKER",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "MONTH DAY? YEAR?",
        "DAY of? MONTH YEAR?",
        "DAY MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "CAL_MONTH DAY? YEAR?",
        "DAY of? CAL_MONTH YEAR?",
        "DAY CAL_MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "roman_date": {
      "orders": [
        "ad ORD ANCHOR_DAY MONTH",
        "ad ORD ANCHOR_DAY of MONTH",
        "PRIDIE ANCHOR_DAY MONTH",
        "PRIDIE ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY MONTH"
      ]
    },
    "regnal_date": {
      "orders": [
        "ERANAME NUM",
        "ORD year_word of ERANAME",
        "consulship of ERANAME"
      ]
    },
    "clock_time": {
      "orders": [
        "CLOCK of? article? MERIDIEM? ZONE?",
        "at article? HOUR CLOCKDIR article? FRACTION of? article? MERIDIEM? ZONE?",
        "article HOUR CLOCKDIR article? FRACTION of? article? MERIDIEM? ZONE?",
        "oclock HOUR of? article? MERIDIEM? ZONE?",
        "at article? HOUR of? article? MERIDIEM? ZONE?",
        "article HOUR of? article? MERIDIEM ZONE?",
        "HOUR of? article? MERIDIEM ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp",
        "NUM year_word before present"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word",
        "NUM SCALE of? year_word before present"
      ]
    },
    "named_period": {
      "orders": [
        "in? during? article? PART? PERIOD"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "iso_week_date": {
      "orders": [
        "ISOWEEK"
      ]
    },
    "numeric_date": {
      "orders": [
        "NUMDATE"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? article? NUM plural",
        "PART? article? year_word DECADE",
        "PART? article? DECADE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "decade_bc": {
      "orders": [
        "article? NUM plural bc"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "un",
      "una"
    ],
    "2": [
      "par",
      "pareya"
    ],
    "3": [
      "dellos",
      "delles",
      "unos",
      "unes"
    ],
    "0.5": [
      "media",
      "mediu"
    ],
    "0.25": [
      "cuartu",
      "cuartos"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_ast",
  "base_grammar": {
    "marker_position": "post",
    "override": {
      "rel_period": [
        "article? REL_MARKER UNIT"
      ]
    }
  }
}
