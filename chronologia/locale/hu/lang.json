{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "indef? UNIT MARKER",
        "MARKER NUM UNIT"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "YEAR MONTH DAY?",
        "MONTH DAY YEAR?",
        "MONTH DAY?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "HOUR oclock MERIDIEM? ZONE?",
        "MERIDIEM at? HOUR oclock? ZONE?",
        "FRACTION HOUR MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "bc NUM",
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE year_word ago",
        "ago NUM SCALE year_word"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "iso_week_date": {"orders": ["ISOWEEK"]},
    "numeric_date": {
      "orders": [
        "NUMDATE"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "article? year_word GYEAR",
        "GYEAR"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "NUM week_num YEAR?",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "REL_MARKER UNIT PART",
        "UNIT PART",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": false,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true,
    "bare_quarter_to": true
  },
  "positions": {
    "until": "affix",
    "since": "post"
  },
  "quantifiers": {
    "1": [
      "egy"
    ],
    "2": [
      "pár"
    ],
    "3": [
      "néhány",
      "pár"
    ],
    "0.5": [
      "fél"
    ],
    "0.25": [
      "negyed"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_agglutinative:fold_hu",
  "base_grammar": {
    "season_year_order": "year_first",
    "override": {
      "rel_period": [
        "REL_MARKER article? UNIT"
      ]
    },
    "extend": {
      "rel_period": [
        "UNIT REL_MARKER"
      ]
    }
  }
}
