{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": false,
  "dotted_date": false
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "in_frame? NUM il? UNIT MARKER",
    "in_frame? USG MARKER"
   ]
  },
  "calendar_date": {
   "orders": [
    "DAY of MONTH YEAR?",
    "DAY MONTH YEAR?",
    "MONTH DAY? YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "at? article? HOUR CLOCKDIR FRACTION MERIDIEM?",
    "at? article? HOUR CLOCKDIR MINUTE minute_word? MERIDIEM?",
    "at article? HOUR MERIDIEM?",
    "at? article HOUR MERIDIEM?",
    "at? CLOCK MERIDIEM?",
    "at? article? LANDMARK"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "year_word GYEAR",
    "GYEAR"
   ]
  }
 },
 "base_grammar": {
  "marker_position": "post",
  "extend": {
   "rel_period": [
    "REL_MARKER article? UNIT",
    "article? UNIT REL_MARKER"
   ],
   "weekday_ref": [
    "REL_MARKER article? WEEKDAY"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true,
  "toward_hour_12h": true
 },
 "quantifiers": {
  "1": [
   "wieħed",
   "waħda"
  ],
  "0.5": [
   "nofs"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_maltese:fold_mt"
}
