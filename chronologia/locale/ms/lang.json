{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "WEEKDAY REL_MARKER",
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "UNIT REL_MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "WEEKEND REL_MARKER",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad"
      ]
    },
    "year_ref": {
      "orders": [
        "GYEAR"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "quarter_word ORD YEAR?",
        "quarter_word REL_MARKER",
        "ORD quarter_word YEAR?"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "PART UNIT REL_MARKER",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_ms",
  "quantifiers": {
    "1": [
      "satu"
    ],
    "0.5": [
      "setengah",
      "separuh"
    ],
    "0.25": [
      "suku"
    ]
  }
}
