{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": true,
  "dotted_date": true
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "NUM UNIT MARKER",
    "MARKER NUM UNIT",
    "MARKER USG"
   ]
  },
  "calendar_date": {
   "orders": [
    "DAY MONTH YEAR?",
    "MONTH DAY? YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK MERIDIEM?",
    "at? HOUR CLOCKDIR indef? FRACTION MERIDIEM?",
    "at? HOUR CLOCKDIR MINUTE minute_word? MERIDIEM?",
    "at HOUR MERIDIEM?",
    "at? LANDMARK"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "year_word GYEAR",
    "GYEAR"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true,
  "toward_hour_12h": true
 },
 "quantifiers": {
  "1": [
   "një"
  ],
  "0.5": [
   "gjysmë",
   "gjysëm"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_albanian:fold_sq",
 "base_grammar": {
  "marker_position": "both"
 }
}
