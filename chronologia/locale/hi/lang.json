{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": false
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "NUM UNIT MARKER"
   ]
  },
  "weekend_ref": {
   "orders": [
    "REL_MARKER WEEKEND",
    "WEEKEND REL_MARKER",
    "WEEKEND"
   ]
  },
  "calendar_date": {
   "orders": [
    "DAY MONTH YEAR? on?",
    "MONTH DAY? YEAR? on?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK MERIDIEM?",
    "FRACTION HOUR at? MERIDIEM?",
    "HOUR CLOCKDIR MINUTE UNIT? MERIDIEM?",
    "HOUR at MERIDIEM?",
    "LANDMARK at?"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "GYEAR"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true,
  "bare_half_past": true,
  "bare_quarter_past": true
 },
 "quantifiers": {
  "1": [
   "एक"
  ],
  "0.5": [
   "आधा",
   "आधी"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_indic:fold_hi",
 "base_grammar": {
  "marker_position": "post",
  "extend": {
   "weekday_ref": [
    "REL_MARKER WEEKDAY on",
    "WEEKDAY REL_MARKER on",
    "WEEKDAYFULL on"
   ],
   "daypart_ref": [
    "REL_MARKER DAYPART on",
    "DAYPART on"
   ]
  }
 }
}
