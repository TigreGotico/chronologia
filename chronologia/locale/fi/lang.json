{
  "positions": {
    "until": "post",
    "from": "post"
  },
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": true,
    "dotted_date": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "indef? UNIT MARKER",
        "MARKER NUM UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "at HOUR oclock MERIDIEM? ZONE?",
        "HOUR oclock MERIDIEM? ZONE?",
        "FRACTION HOUR MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc",
        "bc NUM"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE year_word ago",
        "ago NUM SCALE year_word"
      ]
    },
    "year_ref": {
      "orders": [
        "in year_word GYEAR",
        "year_word GYEAR",
        "GYEAR"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "MONTH PART YEAR?"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "REL_MARKER UNIT PART",
        "UNIT PART",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": true
  },
  "quantifiers": {
    "1": [
      "yksi",
      "yhden"
    ],
    "2": [
      "pari"
    ],
    "3": [
      "muutama"
    ],
    "0.5": [
      "puoli"
    ],
    "0.25": [
      "neljännes",
      "vartti"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_agglutinative:fold_fi",
  "base_grammar": {
    "disable": [
      "calendar_date"
    ],
    "extend": {
      "rel_period": [
        "article? UNIT REL_MARKER"
      ],
      "scoped_ordinal": [
        "MONTH ORD WEEKDAY YEAR?"
      ]
    }
  }
}