{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? NUM plural bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "MARKER indef? QUANT? of? indef? UNIT",
        "MARKER indef? NUM of? indef? UNIT",
        "indef? QUANT? of? indef? UNIT MARKER",
        "indef? NUM of? indef? UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "named_day_after": {
      "orders": [
        "article? indef? UNIT after DAY_WORD"
      ]
    },
    "named_day_before": {
      "orders": [
        "article? indef? UNIT before DAY_WORD"
      ]
    },
    "weekday_offset": {
      "orders": [
        "indef? QUANT? UNIT from WEEKDAY",
        "indef? NUM UNIT from WEEKDAY"
      ]
    },
    "weekday_ref": {
      "orders": [
        "REL_MARKER WEEKDAY",
        "WEEKDAY REL_MARKER"
      ]
    },
    "rel_period": {
      "orders": [
        "article? UNIT REL_MARKER",
        "article? REL_MARKER UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND REL_MARKER",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "MONTH DAY? YEAR?",
        "DAY of? MONTH YEAR?",
        "DAY MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "CAL_MONTH DAY? YEAR?",
        "DAY of? CAL_MONTH YEAR?",
        "DAY CAL_MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "roman_date": {
      "orders": [
        "ad ORD ANCHOR_DAY MONTH",
        "ad ORD ANCHOR_DAY of MONTH",
        "PRIDIE ANCHOR_DAY MONTH",
        "PRIDIE ANCHOR_DAY of MONTH",
        "ANCHOR_DAY of MONTH",
        "ANCHOR_DAY MONTH"
      ]
    },
    "regnal_date": {
      "orders": [
        "ERANAME NUM",
        "ORD year_word of ERANAME",
        "consulship of ERANAME"
      ]
    },
    "season_ref": {
      "orders": [
        "SEASON of YEAR",
        "REL_MARKER SEASON",
        "SEASON YEAR?"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? ORD SEL_UNIT of article? SORD SCOPE_UNIT",
        "article? ordlast SEL_UNIT of article? SORD SCOPE_UNIT",
        "article? ORD WEEKDAY of MONTH YEAR?",
        "article? ordlast WEEKDAY of MONTH YEAR?",
        "article? ORD UNIT of MONTH YEAR?",
        "article? ordlast UNIT of MONTH YEAR?",
        "article? ORD UNIT of article? year_word YEAR?",
        "article? ordlast UNIT of article? year_word YEAR?",
        "article? ORD SCOPE_UNIT"
      ]
    },
    "clock_time": {
      "orders": [
        "CLOCK article? MERIDIEM? ZONE?",
        "at HOUR oclock CLOCKDIR article? FRACTION article? MERIDIEM? ZONE?",
        "HOUR oclock CLOCKDIR article? FRACTION article? MERIDIEM? ZONE?",
        "at HOUR oclock article? MERIDIEM? ZONE?",
        "HOUR oclock article? MERIDIEM? ZONE?",
        "at HOUR article? MERIDIEM? ZONE?",
        "HOUR article? MERIDIEM ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp",
        "NUM year_word before present"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word",
        "NUM SCALE of? year_word before present"
      ]
    },
    "named_period": {
      "orders": [
        "in? during? article? PART? PERIOD"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? article? NUM plural",
        "PART? article? year_word DECADE",
        "article? year_word PART DECADE",
        "PART? article? DECADE"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "half_period": {
      "orders": [
        "article? NUM half of GYEAR",
        "article? NUM half of article? SCOPE_UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "un",
      "une"
    ],
    "2": [
      "couple",
      "paire"
    ],
    "3": [
      "quelques",
      "plusieurs"
    ],
    "0.5": [
      "demi",
      "demie"
    ],
    "0.25": [
      "quart",
      "quarts"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_fr"
}