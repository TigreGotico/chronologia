{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "calendar_date": {
      "orders": [
        "DAY of MONTH YEAR?",
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "year_ref": {
      "orders": [
        "GYEAR"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "holiday_ref": {
      "orders": [
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "weekend_ref": {
      "orders": [
        "article? WEEKEND"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true,
    "weekend_start": 4
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_kab",
  "quantifiers": {
    "1": [
      "yiwen",
      "yiwet"
    ],
    "0.5": [
      "azgen"
    ],
    "0.25": [
      "rrbeɛ"
    ]
  }
}
