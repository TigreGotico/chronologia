{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER NUM UNIT",
        "NUM UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "WEEKDAY REL_MARKER",
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "scoped_ordinal": {
      "orders": [
        "article? WEEKDAY ORD of MONTH YEAR?"
      ]
    },
    "rel_period": {
      "orders": [
        "UNIT REL_MARKER",
        "REL_MARKER UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "WEEKEND REL_MARKER",
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY of MONTH YEAR?",
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "DAY of CAL_MONTH YEAR?",
        "DAY CAL_MONTH YEAR?",
        "CAL_MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "season_ref": {
      "orders": [
        "SEASON of YEAR",
        "REL_MARKER SEASON",
        "SEASON YEAR?"
      ]
    },
    "clock_time": {
      "orders": [
        "at? CLOCK MERIDIEM? ZONE?",
        "CLOCK MERIDIEM? ZONE?",
        "at? HOUR MERIDIEM ZONE?",
        "at? LANDMARK MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad"
      ]
    },
    "deep_time": {
      "orders": [
        "MARKER NUM SCALE year_word",
        "NUM SCALE year_word MARKER"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART of MONTH",
        "PART MONTH"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? DECADE"
      ]
    },
    "year_ref": {
      "orders": [
        "year_word GYEAR",
        "GYEAR"
      ]
    },
    "iso_date": {"orders": ["ISO"]},
    "iso_week_date": {"orders": ["ISOWEEK"]},
    "numeric_date": {"orders": ["NUMDATE"]},
    "holiday_ref": {
      "orders": ["REL_MARKER HOLIDAY", "HOLIDAY YEAR", "YEAR HOLIDAY", "HOLIDAY"]
    },
    "fuzzy_period": {
      "orders": [
        "PART of? UNIT",
        "PART of? UNIT REL_MARKER",
        "PART of? REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "quarter_word ORD of? YEAR",
        "quarter_word ORD YEAR?",
        "quarter_word REL_MARKER",
        "REL_MARKER quarter_word"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of? YEAR",
        "week_num NUM YEAR?"
      ]
    }
  },
  "conventions": {
    "week_start": "sunday",
    "weekend_start": 4,
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_semitic:fold_he",
  "quantifiers": {
    "1": [
      "אחד",
      "אחת"
    ],
    "0.5": [
      "חצי"
    ],
    "0.25": [
      "רבע"
    ]
  }
}
