{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": false,
  "dotted_date": false
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "MARKER NUM UNIT"
   ]
  },
  "calendar_date": {
   "orders": [
    "article? DAY of MONTH",
    "MONTH YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK",
    "at? article HOUR oclock? CLOCKDIR article? FRACTION",
    "FRACTION CLOCKDIR at? article HOUR",
    "at? article HOUR oclock? CLOCKDIR article? MINUTE minute_word?",
    "MINUTE minute_word? CLOCKDIR at? article HOUR",
    "at? article HOUR MINUTE minute_word?",
    "at? article HOUR oclock?",
    "at? LANDMARK"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "GYEAR"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": null,
  "prefer_future": true
 },
 "quantifiers": {
  "1": [
   "unu"
  ],
  "0.5": [
   "duono"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_esperanto:fold_eo"
}
