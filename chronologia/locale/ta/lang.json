{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false,
    "decimal_comma": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK",
        "LANDMARK"
      ],
      "prefer_future": true
    },
    "year_ref": {
      "orders": [
        "GYEAR"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "ஒரு"
    ],
    "0.5": [
      "அரை",
      "பாதி"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_dravidian:fold_ta",
  "base_grammar": {
    "marker_position": "post"
  }
}
