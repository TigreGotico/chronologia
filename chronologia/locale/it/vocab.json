 "sources": {
  "daypart_mattina_it": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale it",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
   "transcribed in chronologia/dayparts.py as [06:00, 12:00).",
   "Sources: Vocabolario Treccani",
   "(https://www.treccani.it/vocabolario/pomeriggio/), which gives",
   "pomeriggio as \"la parte del giorno compresa tra il mezzodi e il",
   "tramonto del sole\"."
  ],
  "daypart_notte_it": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale it",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
   "transcribed in chronologia/dayparts.py as [00:00, 06:00).",
   "Sources: Vocabolario Treccani",
   "(https://www.treccani.it/vocabolario/pomeriggio/), which gives",
   "pomeriggio as \"la parte del giorno compresa tra il mezzodi e il",
   "tramonto del sole\".",
   "The notte is the small hours of the named day. \"domani notte\" is",
   "therefore tomorrow 00:00-06:00: the sera holds the hours to midnight,",
   "so the notte has nowhere else to be, and re-cutting it to English's",
   "wrapping night would contradict the chart it comes from."
  ],
  "daypart_pomeriggio_it": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale it",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
   "transcribed in chronologia/dayparts.py as [12:00, 18:00).",
   "Sources: Vocabolario Treccani",
   "(https://www.treccani.it/vocabolario/pomeriggio/), which gives",
   "pomeriggio as \"la parte del giorno compresa tra il mezzodi e il",
   "tramonto del sole\"."
  ],
  "daypart_sera_it": [
   "Band boundaries: Unicode CLDR 47 Day Period Rules, locale it",
   "(https://www.unicode.org/cldr/charts/47/supplemental/day_periods.html),",
   "transcribed in chronologia/dayparts.py as [18:00, 24:00).",
   "Sources: Vocabolario Treccani",
   "(https://www.treccani.it/vocabolario/pomeriggio/), which gives",
   "pomeriggio as \"la parte del giorno compresa tra il mezzodi e il",
   "tramonto del sole\"."
  ],
  "marker_alarm_at": [
   "Il nome di un oggetto che suona a un'ora impostata, e \"per\" dopo di esso:",
   "\"sveglia per 7\".  \"sveglia [...] (tecnologia) orologio con annessa",
   "suoneria\" (Wikizionario, s.v. \"sveglia\", sostantivo, 2).  \"per [...]",
   "indica uno scopo\" (Wikizionario, s.v. \"per\", 9)."
  ],
  "marker_alarm_joiner": [
   "The words that join two hours that share one later meridiem: \"alarm for 7",
   "or 8 pm\"."
  ],
  "marker_at_counts": [
   "Clock prepositions that also introduce a counted group: a bare hour behind one",
   "is doubtful only right before a word of marker_counted_noun.voc.  Attested in",
   "the parity acceptance rows; no dictionary source checked, a native reviewer is to confirm."
  ],
  "marker_counted_noun": [
   "Nouns that count people or things a clock never takes: a bare hour behind a",
   "clock preposition and directly before one of them is a count (\"wave at 5",
   "people\").  Each word is quoted from its Wiktionary Noun entry",
   "(https://en.wiktionary.org/wiki/<word>); the fetched pages are kept with the audit.",
   "persona: Noun. \"person, people, persons\"",
   "persone: Noun. \"plural of persona\"",
   "ospiti: Noun. \"plural of ospite\"",
   "vicini: Noun. \"plural of vicino\"",
   "vicine: Noun. \"plural of vicina\"",
   "amici: Noun. \"plural of amico\"",
   "amiche: Noun. \"plural of amica\"",
   "bambini: Noun. \"plural of bambino\"",
   "bambine: Noun. \"plural of bambina\"",
   "ragazzi: Noun. \"plural of ragazzo\"",
   "ragazze: Noun. \"plural of ragazza\"",
