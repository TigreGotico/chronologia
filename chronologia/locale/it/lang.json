{
  "tokenizer": {
    "decimal_comma": true,
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "decade_bc": {
      "orders": [
        "article? NUM plural bc"
      ]
    },
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT",
        "MARKER indef? QUANT? of? indef? UNIT",
        "MARKER indef? NUM of? indef? UNIT",
        "indef? QUANT? of? indef? UNIT MARKER",
        "indef? NUM of? indef? UNIT MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "article? WEEKEND REL_MARKER",
        "article? WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "MONTH DAY? YEAR?",
        "DAY of? MONTH YEAR?",
        "DAY MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "CAL_MONTH DAY? YEAR?",
        "DAY of? CAL_MONTH YEAR?",
        "DAY CAL_MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "roman_date": {
      "orders": [
        "ad ORD ANCHOR_DAY MONTH",
        "ad ORD ANCHOR_DAY of MONTH",
        "PRIDIE ANCHOR_DAY MONTH",
        "PRIDIE ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY of MONTH",
        "article? ANCHOR_DAY MONTH"
      ]
    },
    "regnal_date": {
      "orders": [
        "ERANAME NUM",
        "ORD year_word of ERANAME",
        "consulship of ERANAME"
      ]
    },
    "clock_time": {
      "orders": [
        "at? CLOCK article? MERIDIEM? ZONE?",
        "at HOUR CLOCKDIR article? FRACTION article? MERIDIEM? ZONE?",
        "article HOUR CLOCKDIR article? FRACTION article? MERIDIEM? ZONE?",
        "at HOUR CLOCKDIR article? MINUTE article? MERIDIEM? ZONE?",
        "article HOUR CLOCKDIR article? MINUTE article? MERIDIEM? ZONE?",
        "oclock HOUR article? MERIDIEM? ZONE?",
        "at HOUR article? MERIDIEM? ZONE?",
        "article HOUR article? MERIDIEM ZONE?",
        "HOUR article? MERIDIEM ZONE?",
        "at? LANDMARK CLOCKDIR article? FRACTION article? MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?",
        "FRACTION CLOCKDIR HOUR MERIDIEM? ZONE?",
        "MINUTE CLOCKDIR HOUR MERIDIEM? ZONE?"
      ],
      "prefer_future": true
    },
    "military_time": {
      "orders": [
        "MILTIME hours",
        "MILTIMEZ"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "era_bp": {
      "orders": [
        "NUM bp",
        "NUM year_word before present"
      ]
    },
    "deep_time": {
      "orders": [
        "NUM SCALE of? year_word MARKER",
        "MARKER NUM SCALE of? year_word",
        "NUM SCALE of? year_word before present"
      ]
    },
    "year_ref": {
      "orders": [
        "in GYEAR",
        "article? year_word GYEAR",
        "GYEAR",
        "article? year_word NUM SCALE"
      ]
    },
    "decade_ref": {
      "orders": [
        "PART? article? NUM plural",
        "PART? article? year_plural DNUM"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "month_day_ref": {
      "orders": [
        "article? ORD of article? month_word"
      ],
      "prefer_future": true
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "article? ORD quarter_word of YEAR",
        "article? ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of YEAR",
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "article? PART of? article? UNIT",
        "article? PART of? article? REL_MARKER UNIT",
        "article? PART of? article? UNIT REL_MARKER",
        "PART REL_MARKER UNIT"
      ]
    },
    "rel_span": {
      "orders": [
        "NUM REL_MARKER UNIT",
        "article? NUM REL_MARKER UNIT"
      ]
    },
    "rel_span_quarter": {
      "orders": [
        "article? NUM REL_MARKER quarter_word"
      ]
    },
    "rel_span_weekend": {
      "orders": [
        "article? NUM REL_MARKER WEEKEND"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true
  },
  "quantifiers": {
    "1": [
      "un",
      "uno",
      "una"
    ],
    "2": [
      "paio",
      "coppia"
    ],
    "3": [
      "alcuni",
      "alcune",
      "qualche"
    ],
    "0.5": [
      "mezza",
      "mezzo"
    ],
    "0.25": [
      "quarto",
      "quarti"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_romance:fold_it",
  "base_grammar": {
    "marker_position": "post",
    "override": {
      "rel_period": [
        "article? REL_MARKER UNIT"
      ]
    },
    "extend": {
      "scoped_ordinal": [
        "article? CMUNIT ORD"
      ]
    }
  }
}