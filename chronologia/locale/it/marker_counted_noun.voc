# Nouns that count people or things a clock never takes: a bare hour behind a
# clock preposition and directly before one of them is a count ("wave at 5
# people").  Each word is quoted from its Wiktionary Noun entry
# (https://en.wiktionary.org/wiki/<word>); the fetched pages are kept with the audit.
# persona: Noun. "person, people, persons"
# persone: Noun. "plural of persona"
# ospiti: Noun. "plural of ospite"
# vicini: Noun. "plural of vicino"
# vicine: Noun. "plural of vicina"
# amici: Noun. "plural of amico"
# amiche: Noun. "plural of amica"
# bambini: Noun. "plural of bambino"
# bambine: Noun. "plural of bambina"
# ragazzi: Noun. "plural of ragazzo"
# ragazze: Noun. "plural of ragazza"
# adulti: Noun. ""
# giocatori: Noun. "plural of giocatore"
# posti: Noun. "plural of posto"
# tavoli: Noun. "plural of tavolo"
# biglietti: Noun. "plural of biglietto"
# stanze: Noun. "plural of stanza"
# euro: Noun. "euro (currency)"
persona
persone
ospiti
vicini
vicine
amici
amiche
bambini
bambine
ragazzi
ragazze
adulti
giocatori
posti
tavoli
biglietti
stanze
euro
