{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false,
    "decimal_comma": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT"
      ]
    },
    "weekend_ref": {
      "orders": [
        "WEEKEND REL_MARKER",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "day_word? DAY MONTH year_word? YEAR?",
        "MONTH day_word? DAY? year_word? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM?",
        "at? HOUR at CLOCKDIR MINUTE minute_word? MERIDIEM?",
        "at? HOUR at? FRACTION MERIDIEM?",
        "at? HOUR at MERIDIEM?",
        "at? LANDMARK"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "year_ref": {
      "orders": [
        "year_word GYEAR",
        "GYEAR"
      ]
    },
    "decade_ref": {
      "orders": [
        "DCUNIT DNUM"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": true,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_past": true
  },
  "quantifiers": {
    "1": [
      "một"
    ],
    "0.5": [
      "rưỡi",
      "nửa"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_vietnamese:fold_vi",
  "base_grammar": {
    "marker_position": "post",
    "extend": {
      "scoped_ordinal": [
        "CMUNIT ordinal_prefix? ORD"
      ]
    }
  }
}
