{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": false,
  "decimal_comma": true,
  "dotted_date": true
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "NUM UNIT MARKER",
    "MARKER NUM UNIT",
    "MARKER USG",
    "USG MARKER"
   ]
  },
  "weekend_ref": {
   "orders": [
    "REL_MARKER WEEKEND",
    "article? WEEKEND"
   ]
  },
  "calendar_date": {
   "orders": [
    "DAY MONTH YEAR?",
    "DAY of MONTH YEAR?",
    "MONTH DAY? YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK MERIDIEM? ZONE?",
    "at HOUR MERIDIEM? ZONE?",
    "HOUR MERIDIEM ZONE?",
    "at HOUR oclock MERIDIEM? ZONE?",
    "HOUR oclock MERIDIEM? ZONE?",
    "at? LANDMARK ZONE?"
   ],
   "prefer_future": true
  },
  "era_bc": {
   "orders": [
    "NUM bc"
   ]
  },
  "era_ad": {
   "orders": [
    "NUM ad"
   ]
  },
  "year_ref": {
   "orders": [
    "in GYEAR",
    "article? year_word GYEAR",
    "GYEAR"
   ]
  },
  "quarter_ref": {
   "orders": [
    "q NUM YEAR?",
    "ORD quarter_word YEAR?",
    "REL_MARKER quarter_word",
    "quarter_word REL_MARKER"
   ]
  },
  "iso_week_ref": {
   "orders": [
    "week_num NUM of YEAR",
    "week_num NUM YEAR?"
   ]
  },
  "fuzzy_period": {
   "orders": [
    "PART of? UNIT",
    "PART of? REL_MARKER UNIT",
    "PART of? UNIT REL_MARKER"
   ]
  },
  "holiday_ref": {
   "orders": [
    "REL_MARKER HOLIDAY",
    "HOLIDAY YEAR",
    "YEAR HOLIDAY",
    "HOLIDAY"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true
 },
 "quantifiers": {
  "1": [
   "един",
   "една",
   "едно"
  ],
  "0.5": [
   "половин"
  ],
  "0.25": [
   "четвърт"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_slavic:fold_bg",
 "base_grammar": {
  "override": {
   "scoped_ordinal": [
    "article? ORD WEEKDAY of MONTH YEAR?",
    "article? ORD UNIT of MONTH YEAR?",
    "article? ordlast WEEKDAY of MONTH YEAR?"
   ]
  },
  "extend": {
   "weekday_ref": [
    "at WEEKDAYFULL"
   ]
  }
 }
}
