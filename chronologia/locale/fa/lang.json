{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekday_ref": {
      "orders": [
        "WEEKDAY REL_MARKER",
        "REL_MARKER WEEKDAY",
        "WEEKDAYFULL"
      ]
    },
    "rel_period": {
      "orders": [
        "REL_MARKER UNIT",
        "UNIT REL_MARKER"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND REL_MARKER",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "DAY MONTH YEAR?",
        "MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "nongregorian_date": {
      "orders": [
        "DAY CAL_MONTH YEAR?",
        "CAL_MONTH DAY? YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad"
      ]
    },
    "year_ref": {
      "orders": [
        "year_word GYEAR",
        "GYEAR"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "numeric_date": {"orders": ["NUMDATE"]},
    "month_fuzzy": {
      "orders": [
        "PART of? MONTH",
        "PART MONTH"
      ]
    },
    "holiday_ref": {
      "orders": ["REL_MARKER HOLIDAY", "HOLIDAY REL_MARKER", "HOLIDAY YEAR", "YEAR HOLIDAY", "HOLIDAY"]
    },
    "fuzzy_period": {
      "orders": [
        "PART of? UNIT",
        "PART of? UNIT REL_MARKER",
        "PART of? REL_MARKER UNIT"
      ]
    },
    "quarter_ref": {
      "orders": [
        "quarter_word ORD of? YEAR",
        "quarter_word ORD YEAR?",
        "quarter_word REL_MARKER",
        "REL_MARKER quarter_word"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM of? YEAR",
        "week_num NUM YEAR?"
      ]
    }
  },
  "conventions": {
    "week_start": "saturday",
    "weekend_start": 3,
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold:fold_fa",
  "quantifiers": {
    "1": [
      "یک"
    ],
    "0.5": [
      "نیم"
    ],
    "0.25": [
      "ربع"
    ]
  }
}
