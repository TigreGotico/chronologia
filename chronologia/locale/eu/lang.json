{
  "positions": {
    "until": "post"
  },
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": true
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "MARKER NUM UNIT",
        "MARKER indef? UNIT",
        "NUM UNIT MARKER",
        "UNIT NUM MARKER",
        "indef? UNIT MARKER"
      ]
    },
    "named_day": {
      "orders": [
        "DAY_WORD"
      ]
    },
    "weekend_ref": {
      "orders": [
        "REL_MARKER WEEKEND",
        "WEEKEND"
      ]
    },
    "calendar_date": {
      "orders": [
        "YEAR MONTH DAY?",
        "MONTH DAY?",
        "DAY MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "CLOCK MERIDIEM? ZONE?",
        "at HOUR MERIDIEM? ZONE?",
        "HOUR CLOCKDIR FRACTION MERIDIEM? ZONE?",
        "at? LANDMARK ZONE?"
      ],
      "prefer_future": true
    },
    "era_bc": {
      "orders": [
        "NUM bc",
        "bc NUM"
      ]
    },
    "era_ad": {
      "orders": [
        "NUM ad",
        "ad NUM"
      ]
    },
    "deep_time": {
      "orders": [
        "ago NUM SCALE year_word",
        "NUM SCALE year_word ago"
      ]
    },
    "iso_date": {
      "orders": [
        "ISO"
      ]
    },
    "iso_week_date": {"orders": ["ISOWEEK"]},
    "numeric_date": {
      "orders": [
        "NUMDATE"
      ]
    },
    "year_ref": {
      "orders": [
        "year_word GYEAR",
        "GYEAR"
      ]
    },
    "month_fuzzy": {
      "orders": [
        "PART MONTH"
      ]
    },
    "quarter_ref": {
      "orders": [
        "q NUM YEAR?",
        "ORD quarter_word YEAR?",
        "REL_MARKER quarter_word",
        "quarter_word REL_MARKER"
      ]
    },
    "iso_week_ref": {
      "orders": [
        "week_num NUM YEAR?"
      ]
    },
    "fuzzy_period": {
      "orders": [
        "REL_MARKER UNIT PART",
        "UNIT PART",
        "PART UNIT"
      ]
    },
    "holiday_ref": {
      "orders": [
        "REL_MARKER HOLIDAY",
        "HOLIDAY YEAR",
        "YEAR HOLIDAY",
        "HOLIDAY"
      ]
    }
  },
  "conventions": {
    "week_start": "monday",
    "dmy": false,
    "hemisphere": "north",
    "prefer_future": true,
    "bare_half_to": false
  },
  "quantifiers": {
    "1": [
      "bat"
    ],
    "2": [
      "pare"
    ],
    "3": [
      "batzuk"
    ],
    "0.5": [
      "erdi"
    ],
    "0.25": [
      "laurden"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_agglutinative:fold_eu",
  "base_grammar": {
    "season_year_order": "year_first",
    "extend": {
      "rel_period": [
        "article? UNIT REL_MARKER"
      ]
    }
  }
}
