# Unicode CLDR 47, locale eu, cldr-dates-full/main/eu/ca-gregorian.json.
# months.format.abbreviated and months.stand-alone.abbreviated are identical;
# CLDR ships the trailing dot as part of the surface, but the tokenizer strips
# a trailing dot before matching, so the bare form covers both spellings.
abendua
abenduak
abenduaren
abenduean
abenduan
abenduko
abe
