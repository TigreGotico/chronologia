{
 "tokenizer": {
  "split_contractions": false,
  "ordinal_dot": true,
  "decimal_comma": true,
  "dotted_date": true
 },
 "constructions": {
  "relative_offset": {
   "orders": [
    "MARKER NUM UNIT",
    "MARKER USG"
   ]
  },
  "calendar_date": {
   "orders": [
    "YEAR year_word DAY MONTH",
    "YEAR year_word MONTH",
    "DAY MONTH YEAR?",
    "MONTH DAY? YEAR?"
   ],
   "prefer_future": true
  },
  "clock_time": {
   "orders": [
    "CLOCK",
    "FRACTION HOUR",
    "LANDMARK"
   ],
   "prefer_future": true
  },
  "year_ref": {
   "orders": [
    "GYEAR year_word",
    "GYEAR"
   ]
  }
 },
 "conventions": {
  "week_start": "monday",
  "dmy": true,
  "hemisphere": "north",
  "prefer_future": true,
  "bare_half_to": true,
  "toward_hour_12h": true
 },
 "quantifiers": {
  "1": [
   "viens",
   "viena"
  ],
  "0.5": [
   "puse"
  ]
 },
 "guards": {
  "bare_year_min_digits": 4
 },
 "hook": "chronologia.extract.numfold_latvian:fold_lv"
}
