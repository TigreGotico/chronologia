{
  "tokenizer": {
    "split_contractions": false,
    "ordinal_dot": false,
    "decimal_comma": false
  },
  "constructions": {
    "relative_offset": {
      "orders": [
        "NUM UNIT MARKER",
        "MARKER NUM UNIT"
      ]
    },
    "calendar_date": {
      "orders": [
        "at? day_word? DAY MONTH year_word YEAR",
        "at? day_word? DAY MONTH YEAR?",
        "at? MONTH year_word YEAR",
        "at? MONTH YEAR?"
      ],
      "prefer_future": true
    },
    "clock_time": {
      "orders": [
        "at? CLOCK",
        "at? LANDMARK"
      ],
      "prefer_future": true
    },
    "year_ref": {
      "orders": [
        "at? year_word GYEAR",
        "GYEAR"
      ]
    }
  },
  "conventions": {
    "dmy": true,
    "hemisphere": null,
    "prefer_future": true
  },
  "quantifiers": {
    "0.5": [
      "ครึ่ง"
    ]
  },
  "guards": {
    "bare_year_min_digits": 4
  },
  "hook": "chronologia.extract.numfold_thai:fold_th",
  "base_grammar": {
    "marker_position": "post"
  }
}
